---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.jsx';

export async function getStaticPaths() {
	const entries = await getCollection('knowledge');
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: entry,
	}));
}
type Props = CollectionEntry<'knowledge'>;

const currentEntry = Astro.props;
const { Content } = await currentEntry.render();

const knowledgeEntries = await getCollection('knowledge');
const nodes = knowledgeEntries.map((entry) => ({
	id: entry.slug,
	name: entry.data.title,
	val: 1, // Node size
}));

// Basic link extraction
const links: any[] = [];
knowledgeEntries.forEach((entry) => {
	const content = entry.body;
	const linkRegex = /\[.*?\]\(\/knowledge\/(.*?)\)/g;
	let match;
	while ((match = linkRegex.exec(content)) !== null) {
		const targetSlug = match[1];
		if (nodes.find(n => n.id === targetSlug)) {
			links.push({
				source: entry.slug,
				target: targetSlug,
			});
		}
	}
});

const graphData = { nodes, links };
---

<Layout title={`${currentEntry.data.title} | Knowledge Base | Cyber Sentinel`}>
	<div class="h-[calc(100vh-120px)] flex flex-col">
		<header class="mb-8 border-b border-surface-highest pb-4 flex justify-between items-center">
			<div>
				<h1 class="text-4xl text-primary font-display font-bold">/opt/knowledge</h1>
				<p class="text-on-surface-variant font-mono text-sm uppercase tracking-wider">Zettelkasten Neural Network</p>
			</div>
			<div>
				<input type="text" placeholder="Search knowledge..." class="bg-surface-lowest border-b border-outline text-on-surface p-2 focus:outline-none focus:border-primary font-mono text-sm w-64 transition-colors" />
			</div>
		</header>

		<div class="flex-grow flex gap-4 overflow-hidden relative">
			<!-- Graph View -->
			<div class="w-1/3 bg-surface-low border border-surface-highest overflow-hidden rounded-sm relative hidden md:block">
				<KnowledgeGraph client:only="react" graphData={graphData} />
				<div class="absolute bottom-4 right-4 text-xs font-mono text-on-surface-variant">
					[ Interactive Map ]
				</div>
			</div>

			<!-- Note Timeline View -->
			<div class="w-full md:w-2/3 overflow-x-auto flex space-x-4 p-4 bg-surface-lowest items-start scrollbar-hide">
				<div class="min-w-full md:min-w-[500px] h-full bg-surface-low border border-surface-highest p-8 relative flex flex-col shadow-2xl">
					<div class="flex justify-between items-center mb-6">
						<h2 class="text-3xl font-display font-bold text-on-surface">{currentEntry.data.title}</h2>
						{currentEntry.data.tags && (
							<div class="flex space-x-2">
								{currentEntry.data.tags.map((tag) => (
									<span class="text-xs bg-surface-highest text-on-surface-variant font-mono px-2 py-1 uppercase">{tag}</span>
								))}
							</div>
						)}
					</div>

					<div class="prose prose-invert prose-p:text-on-surface-variant prose-headings:text-on-surface prose-headings:font-display prose-a:text-tertiary hover:prose-a:text-primary transition-colors flex-grow overflow-y-auto pr-4">
						<Content />
					</div>

					<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-tertiary"></div>
				</div>
			</div>
		</div>
	</div>
</Layout>
